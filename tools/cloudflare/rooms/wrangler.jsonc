// Online rooms for the browser build: `npx wrangler deploy -c tools/cloudflare/rooms/wrangler.jsonc`,
// or `npx wrangler dev` in this folder to run it on 127.0.0.1:8787 for local testing.
// It serves no game files, so it is not behind Cloudflare Access (which also blocks WebSockets).
{
  "name": "mkw-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
